erDiagram
  CUSTOM_USER {
    bigint id PK
    varchar email UK
    varchar role
    varchar grammatical_gender
  }
  STUDENT {
    bigint id PK
    bigint user_id FK,UK
    varchar_20 matricula UK
    varchar nombre_completo
    varchar cohorte
  }
  SEMESTER { bigint id PK bigint student_id FK smallint numero date fecha_inicio date fecha_fin boolean is_active }
  ACADEMIC_COMMITTEE { bigint id PK bigint student_id FK,UK }
  COMMITTEE_MEMBERSHIP { bigint id PK bigint committee_id FK bigint user_id FK varchar role "ASESOR | COASESOR | COMMITTEE_MEMBER" }
  ADMIN_AUDIT_LOG { bigint id PK bigint actor_id FK bigint target_user_id FK bigint committee_assignment_id FK json details }
  TUTORING_SESSION { bigint id PK bigint student_id FK bigint semester_id FK date fecha_sesion varchar modalidad bigint created_by_id FK }
  TUTORING_PARTICIPANT { bigint id PK bigint session_id FK bigint user_id FK varchar rol_en_sesion }
  TUTORING_OBSERVATION { bigint id PK bigint session_id FK bigint autor_id FK text observaciones_detalladas }
  AGREEMENT { bigint id PK bigint session_id FK bigint student_id FK bigint responsable_id FK varchar estado date fecha_limite bigint created_by_id FK }
  AGREEMENT_AUDIT_LOG { bigint id PK bigint agreement_id FK bigint user_id FK varchar estado_anterior varchar estado_nuevo }
  THESIS_PROGRESS { bigint id PK bigint student_id FK bigint semester_id FK smallint porcentaje_avance json componentes_json bigint registrado_por_id FK }
  EVIDENCE { bigint id PK bigint student_id FK bigint semester_id FK varchar tipo varchar actividad_tipo bigint actividad_id bigint file_size_bytes bigint created_by_id FK }
  PUBLICATION { bigint id PK bigint student_id FK bigint semester_id FK bigint evidencia_id FK varchar titulo }
  ACADEMIC_EVENT { bigint id PK bigint student_id FK bigint semester_id FK bigint evidencia_id FK varchar nombre_evento }
  RESEARCH_STAY { bigint id PK bigint student_id FK bigint semester_id FK bigint evidencia_id FK date fecha_inicio date fecha_fin }
  OTHER_PRODUCT { bigint id PK bigint student_id FK bigint semester_id FK bigint evidencia_id FK varchar titulo }

  CUSTOM_USER ||--o| STUDENT : profile
  STUDENT ||--o{ SEMESTER : has
  STUDENT ||--o| ACADEMIC_COMMITTEE : has
  ACADEMIC_COMMITTEE ||--o{ COMMITTEE_MEMBERSHIP : contains
  CUSTOM_USER ||--o{ COMMITTEE_MEMBERSHIP : participates
  CUSTOM_USER ||--o{ ADMIN_AUDIT_LOG : acts
  COMMITTEE_MEMBERSHIP o|--o{ ADMIN_AUDIT_LOG : referenced
  STUDENT ||--o{ TUTORING_SESSION : receives
  SEMESTER ||--o{ TUTORING_SESSION : groups
  CUSTOM_USER o|--o{ TUTORING_SESSION : creates
  TUTORING_SESSION ||--o{ TUTORING_PARTICIPANT : contains
  CUSTOM_USER ||--o{ TUTORING_PARTICIPANT : attends
  TUTORING_SESSION ||--o{ TUTORING_OBSERVATION : has
  CUSTOM_USER ||--o{ TUTORING_OBSERVATION : authors
  TUTORING_SESSION o|--o{ AGREEMENT : originates
  STUDENT ||--o{ AGREEMENT : owns
  CUSTOM_USER ||--o{ AGREEMENT : responsible
  AGREEMENT ||--o{ AGREEMENT_AUDIT_LOG : audits
  CUSTOM_USER o|--o{ AGREEMENT_AUDIT_LOG : changes
  STUDENT ||--o{ THESIS_PROGRESS : tracks
  SEMESTER ||--o{ THESIS_PROGRESS : groups
  STUDENT ||--o{ EVIDENCE : owns
  SEMESTER o|--o{ EVIDENCE : contextualizes
  STUDENT ||--o{ PUBLICATION : produces
  STUDENT ||--o{ ACADEMIC_EVENT : attends
  STUDENT ||--o{ RESEARCH_STAY : performs
  STUDENT ||--o{ OTHER_PRODUCT : produces
  SEMESTER o|--o{ PUBLICATION : contextualizes
  SEMESTER o|--o{ ACADEMIC_EVENT : contextualizes
  SEMESTER o|--o{ RESEARCH_STAY : contextualizes
  SEMESTER o|--o{ OTHER_PRODUCT : contextualizes
  EVIDENCE o|--o{ PUBLICATION : supports
  EVIDENCE o|--o{ ACADEMIC_EVENT : supports
  EVIDENCE o|--o{ RESEARCH_STAY : supports
  EVIDENCE o|--o{ OTHER_PRODUCT : supports
